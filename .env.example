# Copy this file to .env and fill in real values before running setup.sh
POSTGRES_PASSWORD=change-me-to-a-strong-password

# Free subdomain from https://www.duckdns.org (login with GitHub/Google, add a domain)
DUCKDNS_DOMAIN=your-subdomain.duckdns.org
DUCKDNS_TOKEN=your-duckdns-token

# Used only for Let's Encrypt renewal notices
LETSENCRYPT_EMAIL=you@example.com
