# Copy this file to .env and fill in real values before running setup.sh
POSTGRES_PASSWORD=change-me-to-a-strong-password

# Free subdomain from https://www.duckdns.org (login with GitHub/Google, add a domain)
DUCKDNS_DOMAIN=your-subdomain.duckdns.org
DUCKDNS_TOKEN=your-duckdns-token

# Used only for Let's Encrypt renewal notices
LETSENCRYPT_EMAIL=you@example.com

# Password for certs/oidckeystore.p12 (needed by mimoto-service). Get the .p12 file itself
# from whoever manages it - it is NOT in git (see certs/README.md) - and copy it to certs/
# on the server before starting mimoto-service.
OIDC_P12_PASSWORD=change-me
